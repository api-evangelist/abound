{
  "opencollection": "1.0.0",
  "info": {
    "name": "Abound API - v4 1099-INT 1099-NEC API",
    "version": "4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "1099-NEC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all 1099-NEC documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "filingYear",
                "value": "",
                "type": "query"
              },
              {
                "name": "payeeTinFingerprint",
                "value": "",
                "type": "query"
              },
              {
                "name": "payerTinFingerprint",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of 1099-NEC documents."
        },
        {
          "info": {
            "name": "Create a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a 1099-NEC document and subsequently kicks off a TIN Verification, if the name and TIN combo has not been used before."
        },
        {
          "info": {
            "name": "Retrieve a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the details of an existing 1099-NEC document."
        },
        {
          "info": {
            "name": "Delete a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a 1099-NEC document. Once an action (`/file`, `/correct`, `/void`) has been executed on a 1099-NEC, it cannot be deleted."
        },
        {
          "info": {
            "name": "Correct a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId/correct",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Files a new corrected 1099-NEC and relates it to the original document. A 1099-NEC can be corrected only after it has reached the `FILED` status. Automatically handles both one-transaction and two-transaction corrections."
        },
        {
          "info": {
            "name": "File a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId/file",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Files a 1099-NEC document."
        },
        {
          "info": {
            "name": "Mail a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId/mail",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Mails a 1099-NEC document."
        },
        {
          "info": {
            "name": "Void a 1099-NEC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production-api.withabound.com/v4/documents/1099-nec/:documentId/void",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Files a new voided 1099-NEC and relates it to the original document. A 1099-NEC can be voided only after it has reached the `FILED` status."
        }
      ]
    }
  ],
  "bundled": true
}